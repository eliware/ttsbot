{
  "name": "@eliware/ttsbot",
  "version": "15.1.0",
  "type": "module",
  "description": "Discord text-to-speech bot using OpenAI TTS",
  "keywords": [
    "discord",
    "text-to-speech",
    "openai",
    "tts"
  ],
  "private": true,
  "main": "./bin/ttsbot.mjs",
  "bin": {
    "ttsbot": "bin/ttsbot.mjs",
    "docker-health-smoke": "bin/docker-health-smoke.mjs"
  },
  "scripts": {
    "start": "node --no-deprecation bin/ttsbot.mjs",
    "test": "eliware-test",
    "lint": "eliware-test --lint",
    "audit": "eliware-test --audit",
    "format": "eliware-test --format",
    "format:check": "eliware-test --format-check",
    "test:gaps": "npm test 2>&1 | grep '|' | grep -vF '|     100 |      100 |     100 |     100 |'",
    "smoke:docker": "node bin/docker-health-smoke.mjs"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@discordjs/opus": "^0.11.0",
    "@discordjs/voice": "^0.19.2",
    "@eliware/common": "^15.0.1",
    "@eliware/discord": "^15.0.2",
    "@eliware/openai": "^15.0.1",
    "@eliware/resampler": "^15.0.1",
    "discord.js": "^14.28.0",
    "dotenv": "^18.0.9",
    "openai": "^7.47.0",
    "prism-media": "^1.3.5"
  },
  "devDependencies": {
    "@eliware/test": "^15.1.0",
    "oxlint": "^1.90.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.mjs"
    ],
    "collectCoverageFrom": [
      "src/**/*.mjs"
    ],
    "coverageReporters": [
      "text",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "statements": 100,
        "lines": 100,
        "functions": 100
      }
    }
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "proseWrap": "preserve",
    "endOfLine": "lf"
  },
  "author": "Eliware <eliware@eliware.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliware/ttsbot.git"
  },
  "homepage": "https://github.com/eliware/ttsbot#readme",
  "bugs": {
    "url": "https://github.com/eliware/ttsbot/issues"
  },
  "eliware": {
    "id": "E-3040",
    "apply": [
      "general",
      "application",
      "discord",
      "ghcr-published"
    ]
  },
  "allowScripts": {
    "@discordjs/opus@0.11.0": true
  },
  "overrides": {
    "minimatch": "^11.0.3",
    "tar": "^7.5.22"
  }
}
